# CSIS Hub Desk — copy to .env.local (never commit real values).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the customer portal and the inbound-email webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site (used in links inside emails).
NEXT_PUBLIC_SITE_URL=https://agenticireland.ie

# The mailbox customers write to, e.g. support@agenticireland.ie
CSIS_SUPPORT_EMAIL=support@agenticireland.ie
# Shown as the sender on outgoing mail. Must be a verified Resend sender.
CSIS_FROM_EMAIL="Agentic Ireland Support <support@agenticireland.ie>"

# Outgoing mail (https://resend.com). Without it replies are saved but not emailed.
RESEND_API_KEY=

# Shared secret for the inbound-email webhook: POST /api/inbound-email?secret=...
CSIS_INBOUND_SECRET=

# Shown on the customer portal
NEXT_PUBLIC_COMPANY_NAME="Agentic Ireland"
